<?xml version="1.0" encoding="utf-8"?><!--
   Notification content is sensitive and must stay on the device.
   These rules apply to Android 11 and lower; data_extraction_rules.xml
   covers Android 12+.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="notify_later_notifications.xml" />
    <exclude domain="sharedpref" path="notify_later_settings.xml" />
</full-backup-content>
